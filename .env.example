# ─────────────────────────────────────────────────────────────────────────────
# LocalMind — environment configuration
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# When running via docker-compose these are auto-overridden to use service names.
DATABASE_URL=postgresql+asyncpg://localmind:localmind@localhost:5432/localmind

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Ollama (local AI) ─────────────────────────────────────────────────────────
# Default model to use when no model is specified
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── OpenAI (optional) ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── Anthropic (optional) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-6

# ── Cerebras (optional) — fast inference cloud ────────────────────────────────
# Get your key at https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# ── Vercel AI Gateway (optional) — routes to multiple providers ───────────────
# Get your token at https://vercel.com/account/tokens
# Gateway URL defaults to https://ai-gateway.vercel.sh/v1
# Set a custom URL here if you have a self-hosted or team gateway deployment
VERCEL_API_TOKEN=
VERCEL_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
VERCEL_MODEL=openai/gpt-4o

# ── Active LLM provider ───────────────────────────────────────────────────────
# Which provider is used by default: ollama | openai | anthropic | cerebras | vercel
LLM_PROVIDER=ollama

# ── Embeddings ────────────────────────────────────────────────────────────────
# Provider for generating document embeddings: ollama | openai
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Both providers are normalised to this dimension (OpenAI truncates, Ollama is native 768)
EMBEDDING_DIMENSIONS=768

# ── RAG settings ──────────────────────────────────────────────────────────────
RAG_TOP_K=6
RAG_HYBRID_ALPHA=0.7   # 1.0 = pure semantic, 0.0 = pure keyword

# ── Web Search ────────────────────────────────────────────────────────────────
# Set TAVILY_API_KEY for cloud search (https://tavily.com — free tier available)
# OR use the bundled SearXNG container (no API key needed when using docker-compose)
TAVILY_API_KEY=tvly-...
SEARXNG_HOST=http://localhost:8080
SEARXNG_BASE_URL=http://localhost:8080/
# Change this to a long random string in production!
SEARXNG_SECRET_KEY=localmind-dev-secret-change-me

# ── App settings ──────────────────────────────────────────────────────────────
APP_NAME=LocalMind
APP_ENV=development
SECRET_KEY=change-me-in-production

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

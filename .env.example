# Database
DATABASE_URL=postgresql+asyncpg://localmind:localmind@localhost:5432/localmind

# Redis
REDIS_URL=redis://localhost:6379

# Local LLM (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI (optional)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic (optional)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-6

# Web Search — set at least one of these
TAVILY_API_KEY=tvly-...
SEARXNG_HOST=http://localhost:8080   # self-hosted SearXNG fallback

# Active LLM provider: ollama | openai | anthropic
LLM_PROVIDER=ollama

# Embedding provider: ollama | openai
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768

# RAG settings
RAG_TOP_K=6
RAG_HYBRID_ALPHA=0.7   # 1.0 = pure semantic, 0.0 = pure keyword

# App settings
APP_NAME=LocalMind
APP_ENV=development
SECRET_KEY=change-me-in-production

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

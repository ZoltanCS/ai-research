# Database
DATABASE_URL=postgresql+asyncpg://localmind:localmind@localhost:5432/localmind

# Redis
REDIS_URL=redis://localhost:6379

# Local LLM (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI (optional)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic (optional)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-6

# Web Search (optional)
TAVILY_API_KEY=tvly-...

# Active LLM provider: ollama | openai | anthropic
LLM_PROVIDER=ollama

# Embedding model (used with Ollama or sentence-transformers)
EMBEDDING_MODEL=nomic-embed-text

# App settings
APP_NAME=LocalMind
APP_ENV=development
SECRET_KEY=change-me-in-production

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
